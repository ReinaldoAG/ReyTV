# REYTV - REPARAR EL REGISTRO DE LA SESIÓN TV
# Desde LXQt, abre una terminal y copia SOLO la línea siguiente.
# No reinicies todavía; envía una foto del resultado completo.

curl -fsSL https://raw.githubusercontent.com/ReinaldoAG/ReyTV/main/linux/reytv-install-tv.sh -o /tmp/reytv-tv.sh && bash /tmp/reytv-tv.sh && ls -l /usr/share/xsessions/reytv-tv.desktop /etc/sddm.conf && cat /etc/sddm.conf

# Deben existir ambos archivos y aparecer Session=reytv-tv.desktop.
# No ejecutar ningún comando de rescate de instrucciones anteriores.
