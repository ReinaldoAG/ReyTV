# REYTV - DIAGNÓSTICO Y REPARACIÓN DEL RELOJ
# Ejecutar una línea por vez. No copiar los comentarios (#).

# 1. DIAGNÓSTICO: fotografiar el resultado ANTES de cambiar la hora.
timedatectl status; echo "=== RTC ==="; ls -l /dev/rtc*; cat /sys/class/rtc/rtc0/date /sys/class/rtc/rtc0/time; echo "=== NTP ==="; systemctl list-unit-files systemd-timesyncd.service chrony.service ntpsec.service; echo "=== MENU SERVIDO ==="; curl -fsS http://127.0.0.1:18763/index.html | grep -oc 'Actualizaciones de ReyTV'

# 2. CORRECCIÓN: usar la fecha y hora actuales del teléfono.
# Ejemplo para el 21 de noviembre de 2026 a las 00:33 de Argentina.
# EDITAR la fecha y hora si ya no coinciden.
sudo timedatectl set-time "2026-11-21 00:33:00"

# 3. Verificar que se hayan actualizado tanto el reloj del sistema como el RTC.
timedatectl status

# 4. Instalar sincronización automática (solo después de corregir el reloj).
sudo apt-get update && sudo apt-get install systemd-timesyncd

# 5. Activar el servicio y comprobar su estado.
sudo timedatectl set-ntp true
timedatectl status

# Si APT propone eliminar paquetes importantes o presenta un error, no continuar.
# En Chromium, Ctrl+Shift+R recarga el menú de ReyTV ignorando la caché.
# No desactivar la verificación SSL.
