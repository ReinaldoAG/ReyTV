# REYTV - DIAGNÓSTICO DESPUÉS DEL REINICIO
# Copia únicamente la línea siguiente en la terminal, pulsa Enter y envía una foto.
# No modifica nada. No necesita sudo.

date; echo "=== ARRANQUE ==="; findmnt -no SOURCE,FSTYPE /; cat /proc/cmdline; echo "=== USUARIO Y ARCHIVOS ==="; whoami; ls -l ~/.local/bin/reytv ~/.local/bin/reytv-server.py ~/.config/autostart/reytv.desktop ~/.local/share/reytv/index.html; grep -oc 'Actualizaciones de ReyTV' ~/.local/share/reytv/index.html; echo "=== SERVIDOR ==="; curl -s --max-time 3 -o /dev/null -w 'API HTTP: %{http_code}\n' http://127.0.0.1:18763/api/status

# No reinstales ni formatees nada hasta revisar el resultado.
