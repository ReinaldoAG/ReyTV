# Para salir del modo TV: Ctrl+Alt+Esc y elegir LXQt en SDDM.
# Alternativa: Ctrl+Alt+F3, iniciar sesión como reytv con tu contraseña.
# No reiniciar antes de recoger el registro.

# DIAGNÓSTICO (no cambia nada):
tail -40 ~/.local/state/reytv/tv-session.log
ss -ltn
pgrep -af reytv
curl -s --max-time 3 -o /dev/null -w 'API HTTP: %{http_code}\n' http://127.0.0.1:18763/api/status

# RESCATE (solo si quieres recuperar el escritorio anterior):
sudo reytv-tv-disable
sudo reboot

