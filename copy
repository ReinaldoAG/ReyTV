# REYTV - COMANDOS PARA EL CHROMEBOX
# Copia SOLO una línea de comando por vez, no las líneas con #.

# PASO 1 - Configurar zona horaria de Argentina.
sudo timedatectl set-timezone America/Argentina/Buenos_Aires

# PASO 2 - Corregir el reloj manualmente (NTP no disponible).
# Hora aproximada de la sesión: 20 de noviembre de 2026, 21:49 Argentina.
# Si lo haces más tarde, cambia la fecha y hora por las de tu teléfono.
sudo date -s "2026-11-20 21:49:00 -0300"

# PASO 3 - Comprobar que la fecha y hora estén bien.
date

# PASO 4 - Si el reloj ya está correcto, instalar el actualizador.
curl -fsSL https://raw.githubusercontent.com/ReinaldoAG/ReyTV/main/linux/reytv-enable-updates.sh -o /tmp/reytv-setup.sh && bash /tmp/reytv-setup.sh

# Cuando diga "Actualizador instalado", avisa antes de reiniciar.
# Más adelante configuraremos la sincronización automática.
# No desactives la verificación SSL (curl -k).
