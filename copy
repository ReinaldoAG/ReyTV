# REYTV - REPARAR LA FECHA Y HORA
# Ejecutar una línea de comando por vez. No copiar las líneas con #.

# PASO 1 - Ajustar el reloj de Debian y el reloj físico (RTC).
# IMPORTANTE: cambia la fecha/hora del ejemplo por la de tu teléfono si hace falta.
# Ejemplo: 21 de noviembre de 2026 a las 00:47 de Argentina.
sudo timedatectl set-time "2026-11-21 00:47:00"

# PASO 2 - Verificar ambos relojes ANTES de instalar nada.
timedatectl status

# PASO 3 - Si la fecha es correcta, instalar el servicio oficial de hora automática.
sudo apt-get update && sudo apt-get install systemd-timesyncd

# PASO 4 - Activar la sincronización automática.
sudo timedatectl set-ntp true

# PASO 5 - Comprobar el resultado (repetir si aún está sincronizando).
timedatectl status

# Resultado esperado: NTP service: active; System clock synchronized: yes.
# RTC time aparece en UTC (3 horas por delante de la hora argentina).
# Si un comando da error o APT propone eliminar paquetes importantes, detenerse y enviar foto.
# No desactivar la verificación SSL.
