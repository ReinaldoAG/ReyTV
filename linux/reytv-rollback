#!/usr/bin/env bash
# Rollback de interfaz y servicios de usuario; no modifica Debian ni firmware.
set -euo pipefail
[[ "$(id -u)" != 0 ]] || exit 1
APP="${XDG_DATA_HOME:-$HOME/.local/share}/reytv"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/reytv"
BIN="$HOME/.local/bin"
PREV="$STATE/previous-bundle"
if [[ ! -s "$PREV/index.html" ]]; then
  if [[ ! -s "$STATE/previous-index.html" ]]; then echo 'No hay copia anterior.' >&2; exit 1; fi
  TMP="$(mktemp "$APP/.rollback.XXXXXXXX")"
  cp -p "$STATE/previous-index.html" "$TMP"
  [[ ! -s "$STATE/current.sha" ]] || cp -p "$STATE/current.sha" "$STATE/blocked.sha"
  cp -p "$APP/index.html" "$STATE/previous-index.html"
  mv -f "$TMP" "$APP/index.html"
  [[ ! -s "$STATE/previous.sha" ]] || cp -p "$STATE/previous.sha" "$STATE/current.sha"
  echo 'Interfaz anterior restaurada.'
  exit 0
fi
[[ ! -s "$STATE/current.sha" ]] || cp -p "$STATE/current.sha" "$STATE/blocked.sha"
NAMES=(index.html reytv-server.py reytv-native.py reytv-update reytv-rollback)
TMP="$(mktemp -d "$STATE/.rollback.XXXXXXXX")"
trap 'rm -rf -- "$TMP"' EXIT
for f in "${NAMES[@]}"; do
  if [[ "$f" == index.html ]]; then path="$APP/$f"; else path="$BIN/$f"; fi
  [[ ! -s "$path" ]] || cp -p "$path" "$TMP/$f"
done
[[ ! -s "$STATE/current.sha" ]] || cp -p "$STATE/current.sha" "$TMP/current.sha"
for f in "${NAMES[@]}"; do
  [[ ! -s "$PREV/$f" ]] && continue
  if [[ "$f" == index.html ]]; then dest="$APP/$f"; else dest="$BIN/$f"; fi
  temp="$(mktemp "$(dirname "$dest")/.rollback.XXXXXXXX")"
  cp -p "$PREV/$f" "$temp"
  mv -f "$temp" "$dest"
done
[[ ! -s "$PREV/current.sha" ]] || cp -p "$PREV/current.sha" "$STATE/current.sha"
rm -rf "$PREV"
mv "$TMP" "$PREV"
trap - EXIT
echo 'Versión anterior de ReyTV y sus servicios restaurada.'
