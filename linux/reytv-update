#!/usr/bin/env bash
# ReyTV: actualización de archivos del usuario; jamás /etc, /usr/local ni Debian.
set -euo pipefail
[[ "$(id -u)" != 0 ]] || { echo 'No ejecutar como root.' >&2; exit 1; }
APP="${XDG_DATA_HOME:-$HOME/.local/share}/reytv"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/reytv"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/reytv"
BIN="$HOME/.local/bin"
BRANCH=main
REPO='https://github.com/ReinaldoAG/ReyTV.git'
FORCE=0
if [[ "${1:-}" == --force ]]; then FORCE=1
elif [[ $# -ne 0 ]]; then echo 'Uso: reytv-update [--force]' >&2; exit 2; fi
[[ -s "$APP/index.html" ]] || { echo 'ReyTV no está instalado.' >&2; exit 1; }
mkdir -p "$STATE" "$CACHE" "$BIN"
CLONE="$CACHE/git-source"
if [[ ! -d "$CLONE/.git" ]]; then
  git clone -q --no-checkout --depth 1 --single-branch -b "$BRANCH" "$REPO" "$CLONE"
  SHA="$(git -C "$CLONE" rev-parse HEAD)"
else
  git -C "$CLONE" remote set-url origin "$REPO"
  git -C "$CLONE" fetch -q --depth 1 origin "$BRANCH"
  SHA="$(git -C "$CLONE" rev-parse FETCH_HEAD)"
fi
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || exit 1
if [[ "$FORCE" == 0 && -s "$STATE/blocked.sha" && "$(cat "$STATE/blocked.sha")" == "$SHA" ]]; then
  echo 'La versión fue revertida previamente; esperando una nueva.'
  exit 0
fi
if [[ "$FORCE" == 0 && -s "$STATE/current.sha" && "$(cat "$STATE/current.sha")" == "$SHA" ]]; then
  echo 'ReyTV ya está actualizada.'
  exit 0
fi
TEMP="$(mktemp -d "$CACHE/.reytv-stage.XXXXXXXX")"
trap 'rm -rf -- "$TEMP"' EXIT
NAMES=(index.html reytv-server.py reytv-native.py reytv-update reytv-rollback)
PATHS=(index.html linux/reytv-server.py linux/reytv-native.py linux/reytv-update linux/reytv-rollback)
for j in "${!NAMES[@]}"; do
  git -C "$CLONE" show "$SHA:${PATHS[$j]}" > "$TEMP/${NAMES[$j]}"
done
SIZE="$(wc -c < "$TEMP/index.html")"
[[ "$SIZE" -ge 3000 && "$SIZE" -le 300000 ]] || exit 1
grep -Fq '<title>ReyTV' "$TEMP/index.html" && grep -Fq '</html>' "$TEMP/index.html" || exit 1
python3 -m py_compile "$TEMP/reytv-server.py" "$TEMP/reytv-native.py"
bash -n "$TEMP/reytv-update" "$TEMP/reytv-rollback"
PREV="$STATE/previous-bundle"
OLD="$(mktemp -d "$STATE/.previous.XXXXXXXX")"
for f in "${NAMES[@]}"; do
  if [[ "$f" == index.html ]]; then src="$APP/$f"; else src="$BIN/$f"; fi
  [[ ! -s "$src" ]] || cp -p "$src" "$OLD/$f"
done
[[ ! -s "$STATE/current.sha" ]] || cp -p "$STATE/current.sha" "$OLD/current.sha"
rm -rf -- "$PREV"
mv "$OLD" "$PREV"
for f in "${NAMES[@]}"; do
  if [[ "$f" == index.html ]]; then dest="$APP/$f"; mode=0644
  elif [[ "$f" == *.py ]]; then dest="$BIN/$f"; mode=0644
  else dest="$BIN/$f"; mode=0755; fi
  tmp="$(mktemp "$(dirname "$dest")/.reytv-new.XXXXXXXX")"
  install -m "$mode" "$TEMP/$f" "$tmp"
  mv -f "$tmp" "$dest"
done
printf '%s\n' "$SHA" > "$STATE/current.sha"
rm -f "$STATE/blocked.sha"
echo "ReyTV y servicios actualizados a ${SHA:0:12}. Debian se mantiene separado."
